{
  "name": "domino-sky",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "main",
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"cyan,magenta\" \"pnpm --filter @domino/frontend dev\" \"pnpm --filter @domino/backend dev\"",
    "test": "pnpm --filter @domino/main test",
    "build": "pnpm --filter @domino/main build && pnpm --filter @domino/frontend build && pnpm --filter @domino/backend build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
